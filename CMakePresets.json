{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "linux",
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "web",
      "inherits": "base",
      "cacheVariables": {
        "PLATFORM": "Web",
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSCRIPTEN}/cmake/Modules/Platform/Emscripten.cmake"
      }
    },
    {
      "name": "windows",
      "inherits": "base",
      "cacheVariables": { "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain-mingw.cmake" }
    }
  ]
}
